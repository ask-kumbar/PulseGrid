# Optional overrides for compose.demo.yaml. Copy this to .env.demo, then pass
# --env-file .env.demo to every demo Compose command. Defaults work without it.
# This unauthenticated demo binds only to localhost; do not expose it publicly.
DEMO_DASHBOARD_PORT=8080
DEMO_INGESTION_PORT=8081
# For this demo DSN, use URL-safe letters, digits, hyphens, or underscores.
# Changing this after DB initialization does not change the stored DB password.
DEMO_POSTGRES_PASSWORD=pulsegrid-demo-local-only
